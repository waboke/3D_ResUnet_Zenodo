    "\n",
    "def get_patch_class(\n",
    "    patient_id,\n",
    "    label_patch,\n",
    "    annotation_lookup,\n",
    "    ignore_ambiguous=True\n",
    "):\n",
    "    \"\"\"\n",
    "    0 = background\n",
    "    1 = displaced\n",
    "    2 = non-displaced\n",
    "    3 = buckle\n",
    "    4 = segmental\n",
    "\n",
    "    If multiple classes occur, the class occupying the\n",
    "    greatest number of annotated voxels is selected.\n",
    "    \"\"\"\n",
    "\n",
    "    label_ids, counts = np.unique(\n",
    "        label_patch[label_patch > 0],\n",
    "        return_counts=True\n",
    "    )\n",
    "\n",
    "    if len(label_ids) == 0:\n",
    "        return 0\n",
    "\n",
    "    class_counts = Counter()\n",
    "\n",
    "    for label_id, count in zip(label_ids, counts):\n",
    "\n",
    "        label_code = annotation_lookup.get(\n",
    "            (patient_id, int(label_id)),\n",
    "            None\n",
    "        )\n",
    "\n",
    "        if label_code is None:\n",
    "            continue\n",
    "\n",
    "        if ignore_ambiguous and label_code == -1:\n",
    "            continue\n",
    "\n",
    "        if label_code in (1, 2, 3, 4):\n",
    "            class_counts[int(label_code)] += int(count)\n",
    "\n",
    "    if not class_counts:\n",
    "        return 0\n",
    "\n",
    "    return max(class_counts, key=class_counts.get)\n",
