    "\n",
    "def extract_patient_patches(patient_id):\n",
    "\n",
    "    ct_path, label_path = get_preprocessed_paths(patient_id)\n",
    "\n",
    "    ct = np.load(ct_path)\n",
    "    label = np.load(label_path)\n",
    "\n",
    "    if ct.shape != label.shape:\n",
    "        raise ValueError(\n",
    "            f\"CT/label shape mismatch for {patient_id}\"\n",
    "        )\n",
    "\n",
    "    origins = generate_patch_origins(ct.shape)\n",
    "\n",
    "    positive_records = []\n",
    "    negative_records = []\n",
    "\n",
    "    for origin in origins:\n",
    "\n",
    "        label_patch = extract_patch(label, origin)\n",
    "\n",
    "        patch_class = get_patch_class(\n",
    "            patient_id,\n",
    "            label_patch,\n",
    "            annotation_lookup,\n",
    "            IGNORE_AMBIGUOUS\n",
    "        )\n",
    "\n",
    "        record = {\n",
    "            \"patient_id\": patient_id,\n",
    "            \"origin_x\": origin[0],\n",
    "            \"origin_y\": origin[1],\n",
    "            \"origin_z\": origin[2],\n",
    "            \"class\": int(patch_class),\n",
    "            \"fracture_voxels\": int(np.count_nonzero(label_patch))\n",
    "        }\n",
    "\n",
    "        if patch_class == 0:\n",
    "            negative_records.append(record)\n",
    "        elif record[\"fracture_voxels\"] >= MIN_FRACTURE_VOXELS:\n",
    "            positive_records.append(record)\n",
    "\n",
    "    rng = np.random.default_rng(SEED)\n",
    "\n",
    "    max_negative = int(\n",
    "        len(positive_records) * NEGATIVE_TO_POSITIVE_RATIO\n",
    "    )\n",
    "\n",
    "    if len(negative_records) > max_negative:\n",
    "        indices = rng.choice(\n",
    "            len(negative_records),\n",
    "            size=max_negative,\n",
    "            replace=False\n",
    "        )\n",
    "        negative_records = [\n",
    "            negative_records[i] for i in indices\n",
    "        ]\n",
    "\n",
    "    records = positive_records + negative_records\n",
    "    rng.shuffle(records)\n",
    "\n",
    "    X_patches = []\n",
    "    Y_seg_patches = []\n",
    "    Y_class = []\n",
    "\n",
    "    for record in records:\n",
    "\n",
    "        origin = (\n",
    "            record[\"origin_x\"],\n",
    "            record[\"origin_y\"],\n",
    "            record[\"origin_z\"]\n",
    "        )\n",
    "\n",
    "        ct_patch = extract_patch(ct, origin)\n",
    "        label_patch = extract_patch(label, origin)\n",
    "\n",
    "        X_patches.append(\n",
    "            ct_patch[..., np.newaxis].astype(np.float32)\n",
    "        )\n",
    "\n",
    "        # Binary segmentation target:\n",
    "        # 1 = annotated fracture voxel, 0 = background.\n",
    "        Y_seg_patches.append(\n",
    "            (label_patch > 0).astype(np.float32)[..., np.newaxis]\n",
    "        )\n",
    "\n",
    "        Y_class.append(record[\"class\"])\n",
    "\n",
    "    X_patches = np.asarray(\n",
    "        X_patches,\n",
    "        dtype=np.float32\n",
    "    )\n",
    "\n",
    "    Y_seg_patches = np.asarray(\n",
    "        Y_seg_patches,\n",
    "        dtype=np.float32\n",
    "    )\n",
    "\n",
    "    Y_class = np.asarray(\n",
    "        Y_class,\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    "    manifest = pd.DataFrame(records)\n",
    "\n",
    "    return X_patches, Y_seg_patches, Y_class, manifest\n",
    "\n",
    "\n",
    "print(\"Patient patch-extraction function defined.\")\n"
