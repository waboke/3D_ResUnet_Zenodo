    "     \"name\": \"stdout\",\n",
    "     \"text\": \"Model input shape: (None, 64, 64, 64, 1)\\nModel output shapes: [(None, 5), (None, 64, 64, 64, 1)]\\n\\nClassification output index: 0\\nSegmentation output index: 1\\n\\nModel shape validation: PASS\\n\",\n",
    "     \"output_type\": \"stream\"\n",
