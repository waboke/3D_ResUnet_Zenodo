    "   \"source\": \"from pathlib import Path\\n\\nDATASET_ROOT = Path(\\\"/kaggle/input/datasets/waboke/ribfrac-patch-dataset\\\")\\n\\nprint(\\\"Dataset exists:\\\", DATASET_ROOT.exists())\\n\\nfor path in [\\n    DATASET_ROOT / \\\"RibFrac128\\\" / \\\"X.npy\\\",\\n    DATASET_ROOT / \\\"RibFrac128\\\" / \\\"Y_seg.npy\\\",\\n    DATASET_ROOT / \\\"RibFrac128\\\" / \\\"Y_class.npy\\\",\\n    DATASET_ROOT / \\\"manifests\\\" / \\\"RibFrac128_manifest.csv\\\",\\n    DATASET_ROOT / \\\"patch_extraction_config.json\\\",\\n]:\\n    print(path, \\\"->\\\", path.exists())\",\n",
