    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"from pathlib import Path\\n\\nDATASET_ROOT = Path(\\n    \\\"/kaggle/input/datasets/waboke/ribfrac-patch-dataset\\\"\\n)\\n\\nRIBFRAC128_ROOT = DATASET_ROOT / \\\"RibFrac128\\\"\\n\\nX_PATH = RIBFRAC128_ROOT / \\\"X.npy\\\"\\nY_SEG_PATH = RIBFRAC128_ROOT / \\\"Y_seg.npy\\\"\\nY_CLASS_PATH = RIBFRAC128_ROOT / \\\"Y_class.npy\\\"\\n\\nMANIFEST_PATH = (\\n    DATASET_ROOT / \\\"manifests\\\" / \\\"RibFrac128_manifest.csv\\\"\\n)\\n\\nCONFIG_PATH = DATASET_ROOT / \\\"patch_extraction_config.json\\\"\\n\\nprint(\\\"X:\\\", X_PATH.exists())\\nprint(\\\"Y_seg:\\\", Y_SEG_PATH.exists())\\nprint(\\\"Y_class:\\\", Y_CLASS_PATH.exists())\\nprint(\\\"Manifest:\\\", MANIFEST_PATH.exists())\\nprint(\\\"Config:\\\", CONFIG_PATH.exists())\",\n",
