    "   \"id\": \"fad2847b\",\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"## 6. Architecture validation\\n\\nBefore any training is attempted, the model must satisfy four structural conditions:\\n\\n1. Input is `64 × 64 × 64 × 1`.\\n2. Segmentation output is `64 × 64 × 64 × 1`.\\n3. Classification output has five probabilities.\\n4. The classification probabilities sum to one for each sample.\\n\\n\",\n",
    "   \"metadata\": {}\n",
    "  },\n",
    "  {\n",
    "   \"id\": \"b47309ab\",\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": \"# Cell 12 — Verify model output shapes\\n# ============================================================\\n# MODEL SHAPE VALIDATION\\n# ============================================================\\n\\ninput_shape_expected = (None, 64, 64, 64, 1)\\nseg_shape_expected = (None, 64, 64, 64, 1)\\ncls_shape_expected = (None, 5)\\n\\nprint(\\\"Model input shape:\\\", model.input_shape)\\nprint(\\\"Model output shapes:\\\", model.output_shape)\\n\\n# Validate input\\nassert model.input_shape == input_shape_expected, (\\n    f\\\"Unexpected input shape: {model.input_shape}\\\"\\n)\\n\\n# Validate two outputs\\nassert len(model.output_shape) == 2, (\\n    f\\\"Expected 2 outputs, got {len(model.output_shape)}\\\"\\n)\\n\\n# Determine output order from the actual shapes\\nif model.output_shape[0] == cls_shape_expected:\\n    classification_index = 0\\n    segmentation_index = 1\\n\\nelif model.output_shape[0] == seg_shape_expected:\\n    segmentation_index = 0\\n    classification_index = 1\\n\\nelse:\\n    raise AssertionError(\\n        f\\\"Unexpected first output shape: {model.output_shape[0]}\\\"\\n    )\\n\\n# Validate classification output\\nassert model.output_shape[classification_index] == cls_shape_expected, (\\n    f\\\"Unexpected classification shape: \\\"\\n    f\\\"{model.output_shape[classification_index]}\\\"\\n)\\n\\n# Validate segmentation output\\nassert model.output_shape[segmentation_index] == seg_shape_expected, (\\n    f\\\"Unexpected segmentation shape: \\\"\\n    f\\\"{model.output_shape[segmentation_index]}\\\"\\n)\\n\\nprint(\\\"\\\\nClassification output index:\\\", classification_index)\\nprint(\\\"Segmentation output index:\\\", segmentation_index)\\nprint(\\\"\\\\nModel shape validation: PASS\\\")\",\n",
    "   \"metadata\": {\n",
    "    \"trusted\": true,\n",
