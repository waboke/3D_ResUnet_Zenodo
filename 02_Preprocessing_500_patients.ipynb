    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 24 — Full preprocessing guard\\n\",\n",
    "    \"\\n\",\n",
    "    \"RUN_FULL_PREPROCESSING = False\\n\",\n",
    "    \"\\n\",\n",
    "    \"if RUN_FULL_PREPROCESSING:\\n\",\n",
    "    \"    raise RuntimeError(\\n\",\n",
    "    \"        \\\"Full 500-volume materialization is intentionally disabled. \\\"\\n\",\n",
    "    \"        \\\"Use Notebook 03 to preprocess each patient on demand and \\\"\\n\",\n",
    "    \"        \\\"save only the extracted patient-level patches.\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Full-volume materialization:\\\", RUN_FULL_PREPROCESSING)\\n\",\n",
    "    \"print(\\\"Storage-safe final design: ENABLED\\\")\\n\"\n",
