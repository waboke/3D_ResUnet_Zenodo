    "    \"\\n\",\n",
    "    \"print(json.dumps(PREPROCESSING_CONFIG, indent=2))\\n\",\n",
    "    \"print(\\\"Saved:\\\", CONFIG_PATH)\\n\"\n",
    "   ],\n",
    "   \"id\": \"e7fe856b62c436aa\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 17 — NIfTI preprocessing functions\\n\",\n",
    "    \"\\n\",\n",
    "    \"def normalize_ct_hu(ct):\\n\",\n",
    "    \"    ct = np.asarray(ct, dtype=np.float32)\\n\",\n",
    "    \"    ct = np.clip(ct, HU_MIN, HU_MAX)\\n\",\n",
    "    \"    ct = (ct - HU_MIN) / (HU_MAX - HU_MIN)\\n\",\n",
    "    \"    return ct.astype(CT_DTYPE, copy=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def resample_volume(volume, original_spacing, target_spacing, order):\\n\",\n",
    "    \"    original_spacing = np.asarray(original_spacing, dtype=np.float32)\\n\",\n",
    "    \"    target_spacing = np.asarray(target_spacing, dtype=np.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    zoom_factors = original_spacing / target_spacing\\n\",\n",
    "    \"\\n\",\n",
    "    \"    resampled = zoom(\\n\",\n",
    "    \"        volume,\\n\",\n",
    "    \"        zoom=zoom_factors,\\n\",\n",
    "    \"        order=order,\\n\",\n",
    "    \"        mode=\\\"nearest\\\",\\n\",\n",
    "    \"        prefilter=(order != 0),\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return resampled\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def preprocess_nifti_pair(ct_nii, label_nii):\\n\",\n",
    "    \"    ct = ct_nii.get_fdata(dtype=np.float32)\\n\",\n",
    "    \"    label = label_nii.get_fdata(dtype=np.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ct_spacing = np.asarray(ct_nii.header.get_zooms()[:3], dtype=np.float32)\\n\",\n",
    "    \"    label_spacing = np.asarray(label_nii.header.get_zooms()[:3], dtype=np.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if not np.allclose(ct_spacing, label_spacing, atol=1e-4):\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"CT/label spacing mismatch: {ct_spacing} vs {label_spacing}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if ct.shape != label.shape:\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"CT/label shape mismatch: {ct.shape} vs {label.shape}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ct = normalize_ct_hu(ct)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ct_resampled = resample_volume(\\n\",\n",
    "    \"        ct,\\n\",\n",
    "    \"        ct_spacing,\\n\",\n",
    "    \"        TARGET_SPACING,\\n\",\n",
    "    \"        order=1,\\n\",\n",
    "    \"    ).astype(np.float32)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    label_resampled = resample_volume(\\n\",\n",
    "    \"        label,\\n\",\n",
    "    \"        label_spacing,\\n\",\n",
    "    \"        TARGET_SPACING,\\n\",\n",
    "    \"        order=0,\\n\",\n",
    "    \"    ).astype(np.int16)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    label_resampled = np.rint(label_resampled).astype(np.int16)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if ct_resampled.shape != label_resampled.shape:\\n\",\n",
    "    \"        raise ValueError(\\n\",\n",
    "    \"            f\\\"Resampled CT/label mismatch: \\\"\\n\",\n",
    "    \"            f\\\"{ct_resampled.shape} vs {label_resampled.shape}\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        \\\"ct\\\": ct_resampled,\\n\",\n",
    "    \"        \\\"label\\\": label_resampled,\\n\",\n",
    "    \"        \\\"original_spacing\\\": ct_spacing.tolist(),\\n\",\n",
    "    \"        \\\"target_spacing\\\": TARGET_SPACING.tolist(),\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Preprocessing functions defined.\\\")\\n\"\n",
    "   ],\n",
    "   \"id\": \"a4ab3428bfff6dcc\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 18 — Remote source ZIP index cache\\n\",\n",
    "    \"\\n\",\n",
    "    \"ZIP_INDEX_CACHE = {}\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_source_zip_index(source_name):\\n\",\n",
    "    \"    if source_name in ZIP_INDEX_CACHE:\\n\",\n",
    "    \"        return ZIP_INDEX_CACHE[source_name]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    cfg = SOURCES[source_name]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"Inspecting remote image ZIP: {cfg['image_zip']}\\\")\\n\",\n",
    "    \"    size, entries = read_zip64_central_directory(cfg[\\\"image_url\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ZIP_INDEX_CACHE[source_name] = {\\n\",\n",
    "    \"        \\\"size\\\": size,\\n\",\n",
    "    \"        \\\"entries\\\": entries,\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\n\",\n",
    "    \"        f\\\"Remote ZIP indexed: {len(entries)} members, \\\"\\n\",\n",
    "    \"        f\\\"{size / (1024**3):.2f} GB\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return ZIP_INDEX_CACHE[source_name]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"ZIP index cache ready.\\\")\\n\"\n",
    "   ],\n",
    "   \"id\": \"786aa4c1827f2d11\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 19 — Download one patient from its source archive\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_patient_nifti_from_source(patient_id, source_name):\\n\",\n",
    "    \"    cfg = SOURCES[source_name]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    index = get_source_zip_index(source_name)\\n\",\n",
    "    \"    entries = index[\\\"entries\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    image_member = find_patient_member(entries, patient_id, \\\"image\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"Image member:\\\", image_member)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    image_bytes = get_zip_member_bytes(\\n\",\n",
    "    \"        cfg[\\\"image_url\\\"],\\n\",\n",
    "    \"        entries[image_member],\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    label_zip_path = CACHE_ROOT / cfg[\\\"label_zip\\\"]\\n\",\n",
    "    \"    cache_small_file(cfg[\\\"label_url\\\"], label_zip_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with zipfile.ZipFile(label_zip_path, \\\"r\\\") as zf:\\n\",\n",
    "    \"        label_names = zf.namelist()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        label_candidates = [\\n\",\n",
    "    \"            name for name in label_names\\n\",\n",
    "    \"            if patient_id in Path(name).name\\n\",\n",
    "    \"            and \\\"label\\\" in Path(name).name.lower()\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if not label_candidates:\\n\",\n",
    "    \"            raise FileNotFoundError(\\n\",\n",
    "    \"                f\\\"No label member found for {patient_id} in \\\"\\n\",\n",
    "    \"                f\\\"{cfg['label_zip']}\\\"\\n\",\n",
    "    \"            )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        label_member = sorted(label_candidates)[0]\\n\",\n",
    "    \"        label_bytes = zf.read(label_member)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"Label member:\\\", label_member)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ct_nii = nib.load(io.BytesIO(image_bytes))\\n\",\n",
    "    \"    label_nii = nib.load(io.BytesIO(label_bytes))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return ct_nii, label_nii\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"On-demand patient loader defined.\\\")\\n\"\n",
    "   ],\n",
    "   \"id\": \"db29906a13e9f7f5\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 20 — Complete on-demand preprocessing function\\n\",\n",
    "    \"\\n\",\n",
    "    \"def preprocess_patient(patient_id, source_name):\\n\",\n",
    "    \"    ct_nii, label_nii = load_patient_nifti_from_source(\\n\",\n",
    "    \"        patient_id,\\n\",\n",
    "    \"        source_name,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result = preprocess_nifti_pair(\\n\",\n",
    "    \"        ct_nii,\\n\",\n",
    "    \"        label_nii,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result[\\\"patient_id\\\"] = str(patient_id)\\n\",\n",
    "    \"    result[\\\"source\\\"] = source_name\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return result\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Complete patient preprocessing function defined.\\\")\\n\"\n",
    "   ],\n",
    "   \"id\": \"7b69701dd973e5a1\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
