    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 4 — Working/output directories\\n\",\n",
    "    \"WORK_ROOT = Path(\\\"/kaggle/working/ribfrac_final_preprocessing\\\")\\n\",\n",
    "    \"METADATA_ROOT = WORK_ROOT / \\\"metadata\\\"\\n\",\n",
    "    \"CACHE_ROOT = WORK_ROOT / \\\"cache\\\"\\n\",\n",
    "    \"SMOKE_ROOT = WORK_ROOT / \\\"smoke_test\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"for path in [WORK_ROOT, METADATA_ROOT, CACHE_ROOT, SMOKE_ROOT]:\\n\",\n",
    "    \"    path.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Working root:\\\", WORK_ROOT)\\n\",\n",
    "    \"print(\\\"Metadata root:\\\", METADATA_ROOT)\\n\",\n",
    "    \"print(\\\"Cache root:\\\", CACHE_ROOT)\\n\",\n",
    "    \"print(\\\"Smoke-test root:\\\", SMOKE_ROOT)\\n\"\n",
    "   ],\n",
    "   \"id\": \"1fee42b2f102d3a0\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Source access strategy\\n\",\n",
    "    \"\\n\",\n",
    "    \"Zenodo's image archives are large (for example, Part 1 is 36.6 GB and Part 2 is 14.6 GB), so the notebook does **not** download an entire image archive. citeturn0view0turn1search0\\n\",\n",
    "    \"\\n\",\n",
    "    \"Instead, image archives are accessed using HTTP byte ranges and only the requested patient's ZIP member is downloaded. The small annotation archives are cached locally.\\n\"\n",
    "   ],\n",
    "   \"id\": \"c67791abb1a5dd37\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 5 — HTTP helpers\\n\",\n",
    "    \"\\n\",\n",
    "    \"def http_get_bytes(url, start=None, end=None, timeout=120):\\n\",\n",
    "    \"    headers = {}\\n\",\n",
    "    \"    if start is not None and end is not None:\\n\",\n",
    "    \"        headers[\\\"Range\\\"] = f\\\"bytes={start}-{end}\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    request = Request(\\n\",\n",
    "    \"        url,\\n\",\n",
    "    \"        headers={\\n\",\n",
    "    \"            \\\"User-Agent\\\": \\\"Mozilla/5.0 RibFrac research preprocessing\\\",\\n\",\n",
    "    \"            **headers,\\n\",\n",
    "    \"        },\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    with urlopen(request, timeout=timeout) as response:\\n\",\n",
    "    \"        return response.read(), response.headers\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_remote_size(url):\\n\",\n",
    "    \"    request = Request(\\n\",\n",
    "    \"        url,\\n\",\n",
    "    \"        headers={\\\"User-Agent\\\": \\\"Mozilla/5.0 RibFrac research preprocessing\\\"},\\n\",\n",
    "    \"        method=\\\"HEAD\\\",\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        with urlopen(request, timeout=120) as response:\\n\",\n",
    "    \"            length = response.headers.get(\\\"Content-Length\\\")\\n\",\n",
    "    \"            if length:\\n\",\n",
    "    \"                return int(length)\\n\",\n",
    "    \"    except Exception:\\n\",\n",
    "    \"        pass\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Fallback: request one byte and inspect Content-Range.\\n\",\n",
    "    \"    request = Request(\\n\",\n",
    "    \"        url,\\n\",\n",
    "    \"        headers={\\n\",\n",
    "    \"            \\\"User-Agent\\\": \\\"Mozilla/5.0 RibFrac research preprocessing\\\",\\n\",\n",
    "    \"            \\\"Range\\\": \\\"bytes=0-0\\\",\\n\",\n",
    "    \"        },\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    with urlopen(request, timeout=120) as response:\\n\",\n",
    "    \"        content_range = response.headers.get(\\\"Content-Range\\\", \\\"\\\")\\n\",\n",
    "    \"        match = re.search(r\\\"/(\\\\d+)$\\\", content_range)\\n\",\n",
    "    \"        if match:\\n\",\n",
    "    \"            return int(match.group(1))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    raise RuntimeError(f\\\"Could not determine remote size: {url}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"HTTP helpers defined.\\\")\\n\"\n",
    "   ],\n",
    "   \"id\": \"5d70ef61df200b43\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 6 — ZIP central-directory inspection\\n\",\n",
    "    \"\\n\",\n",
    "    \"def parse_zip64_extra(extra):\\n\",\n",
    "    \"    # ZIP64 extra field ID = 0x0001\\n\",\n",
    "    \"    pos = 0\\n\",\n",
    "    \"    values = []\\n\",\n",
    "    \"    while pos + 4 <= len(extra):\\n\",\n",
    "    \"        header_id, size = struct.unpack(\\\"<HH\\\", extra[pos:pos+4])\\n\",\n",
    "    \"        data = extra[pos+4:pos+4+size]\\n\",\n",
    "    \"        pos += 4 + size\\n\",\n",
    "    \"        if header_id == 0x0001:\\n\",\n",
    "    \"            values.append(data)\\n\",\n",
    "    \"    return values\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def read_zip64_central_directory(url, chunk_size=1024 * 1024):\\n\",\n",
    "    \"    size = get_remote_size(url)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    tail_size = min(size, 1024 * 1024)\\n\",\n",
    "    \"    tail, _ = http_get_bytes(url, size - tail_size, size - 1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # EOCD signature\\n\",\n",
    "    \"    eocd_sig = b\\\"PK\\\\x05\\\\x06\\\"\\n\",\n",
    "    \"    eocd_pos = tail.rfind(eocd_sig)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if eocd_pos < 0:\\n\",\n",
    "    \"        raise RuntimeError(\\\"ZIP End Of Central Directory not found.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    eocd = tail[eocd_pos:eocd_pos + 22]\\n\",\n",
    "    \"    _, disk, cd_disk, entries_disk, entries_total, cd_size32, cd_offset32, comment_len = struct.unpack(\\n\",\n",
    "    \"        \\\"<4sHHHHIIH\\\", eocd\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if cd_size32 != 0xFFFFFFFF and cd_offset32 != 0xFFFFFFFF:\\n\",\n",
    "    \"        cd_size = cd_size32\\n\",\n",
    "    \"        cd_offset = cd_offset32\\n\",\n",
    "    \"        entries_total = entries_total\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        # ZIP64 EOCD locator\\n\",\n",
    "    \"        locator_sig = b\\\"PK\\\\x06\\\\x07\\\"\\n\",\n",
    "    \"        locator_pos = tail.rfind(locator_sig, 0, eocd_pos)\\n\",\n",
    "    \"        if locator_pos < 0:\\n\",\n",
    "    \"            raise RuntimeError(\\\"ZIP64 EOCD locator not found.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        _, _, zip64_eocd_offset, _ = struct.unpack(\\n\",\n",
    "    \"            \\\"<4sIQI\\\", tail[locator_pos:locator_pos + 20]\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        read_size = 1024 * 1024\\n\",\n",
    "    \"        z64, _ = http_get_bytes(\\n\",\n",
    "    \"            url,\\n\",\n",
    "    \"            zip64_eocd_offset,\\n\",\n",
    "    \"            min(size - 1, zip64_eocd_offset + read_size - 1),\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if z64[:4] != b\\\"PK\\\\x06\\\\x06\\\":\\n\",\n",
    "    \"            raise RuntimeError(\\\"ZIP64 EOCD record not found.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        entries_total = struct.unpack_from(\\\"<Q\\\", z64, 32)[0]\\n\",\n",
    "    \"        cd_size = struct.unpack_from(\\\"<Q\\\", z64, 40)[0]\\n\",\n",
    "    \"        cd_offset = struct.unpack_from(\\\"<Q\\\", z64, 48)[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    cd_bytes, _ = http_get_bytes(\\n\",\n",
    "    \"        url,\\n\",\n",
    "    \"        cd_offset,\\n\",\n",
    "    \"        cd_offset + cd_size - 1,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    entries = {}\\n\",\n",
    "    \"    pos = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for _ in range(entries_total):\\n\",\n",
    "    \"        if cd_bytes[pos:pos+4] != b\\\"PK\\\\x01\\\\x02\\\":\\n\",\n",
    "    \"            raise RuntimeError(\\\"Invalid central-directory signature.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"        fixed = cd_bytes[pos:pos+46]\\n\",\n",
    "    \"        fields = struct.unpack(\\\"<4s6H3I5H2I\\\", fixed)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        (\\n\",\n",
    "    \"            signature,\\n\",\n",
    "    \"            version_made,\\n\",\n",
    "    \"            version_needed,\\n\",\n",
    "    \"            flags,\\n\",\n",
    "    \"            compression,\\n\",\n",
    "    \"            mod_time,\\n\",\n",
    "    \"            mod_date,\\n\",\n",
    "    \"            crc32,\\n\",\n",
    "    \"            comp_size32,\\n\",\n",
    "    \"            uncomp_size32,\\n\",\n",
    "    \"            name_len,\\n\",\n",
    "    \"            extra_len,\\n\",\n",
    "    \"            comment_len,\\n\",\n",
    "    \"            disk_start,\\n\",\n",
    "    \"            int_attr,\\n\",\n",
    "    \"            ext_attr,\\n\",\n",
    "    \"            local_offset32,\\n\",\n",
    "    \"        ) = fields\\n\",\n",
    "    \"\\n\",\n",
    "    \"        name_start = pos + 46\\n\",\n",
    "    \"        name = cd_bytes[name_start:name_start + name_len].decode(\\n\",\n",
    "    \"            \\\"utf-8\\\", errors=\\\"replace\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"        extra_start = name_start + name_len\\n\",\n",
    "    \"        extra = cd_bytes[extra_start:extra_start + extra_len]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        comp_size = comp_size32\\n\",\n",
    "    \"        uncomp_size = uncomp_size32\\n\",\n",
    "    \"        local_offset = local_offset32\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if (\\n\",\n",
    "    \"            comp_size32 == 0xFFFFFFFF\\n\",\n",
    "    \"            or uncomp_size32 == 0xFFFFFFFF\\n\",\n",
    "    \"            or local_offset32 == 0xFFFFFFFF\\n\",\n",
    "    \"        ):\\n\",\n",
    "    \"            zip64_chunks = parse_zip64_extra(extra)\\n\",\n",
    "    \"            if not zip64_chunks:\\n\",\n",
    "    \"                raise RuntimeError(f\\\"ZIP64 extra field missing for {name}\\\")\\n\",\n",
    "    \"            data = zip64_chunks[0]\\n\",\n",
    "    \"            zpos = 0\\n\",\n",
    "    \"            if uncomp_size32 == 0xFFFFFFFF:\\n\",\n",
    "    \"                uncomp_size = struct.unpack_from(\\\"<Q\\\", data, zpos)[0]\\n\",\n",
    "    \"                zpos += 8\\n\",\n",
    "    \"            if comp_size32 == 0xFFFFFFFF:\\n\",\n",
    "    \"                comp_size = struct.unpack_from(\\\"<Q\\\", data, zpos)[0]\\n\",\n",
    "    \"                zpos += 8\\n\",\n",
    "    \"            if local_offset32 == 0xFFFFFFFF:\\n\",\n",
    "    \"                local_offset = struct.unpack_from(\\\"<Q\\\", data, zpos)[0]\\n\",\n",
    "    \"                zpos += 8\\n\",\n",
    "    \"\\n\",\n",
    "    \"        entries[name] = {\\n\",\n",
    "    \"            \\\"compression\\\": compression,\\n\",\n",
    "    \"            \\\"compressed_size\\\": int(comp_size),\\n\",\n",
    "    \"            \\\"uncompressed_size\\\": int(uncomp_size),\\n\",\n",
    "    \"            \\\"local_header_offset\\\": int(local_offset),\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"\\n\",\n",
    "    \"        pos = extra_start + extra_len + comment_len\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return size, entries\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Remote ZIP inspection helper defined.\\\")\\n\"\n",
    "   ],\n",
    "   \"id\": \"268e7ac71e7145e9\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 7 — Patient member discovery\\n\",\n",
    "    \"\\n\",\n",
    "    \"def normalize_member_name(name):\\n\",\n",
    "    \"    return name.lstrip(\\\"/\\\").replace(\\\"\\\\\\\\\\\", \\\"/\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def find_patient_member(entries, patient_id, kind):\\n\",\n",
    "    \"    patient_id = str(patient_id)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    candidates = []\\n\",\n",
    "    \"    for name in entries:\\n\",\n",
    "    \"        base = Path(normalize_member_name(name)).name\\n\",\n",
    "    \"        if patient_id in base:\\n\",\n",
    "    \"            lower = base.lower()\\n\",\n",
    "    \"            if kind == \\\"image\\\" and \\\"image\\\" in lower:\\n\",\n",
    "    \"                candidates.append(name)\\n\",\n",
    "    \"            elif kind == \\\"label\\\" and \\\"label\\\" in lower:\\n\",\n",
    "    \"                candidates.append(name)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if not candidates:\\n\",\n",
    "    \"        raise FileNotFoundError(\\n\",\n",
    "    \"            f\\\"No {kind} ZIP member found for patient {patient_id}.\\\"\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if len(candidates) > 1:\\n\",\n",
    "    \"        # Prefer exact conventional filename.\\n\",\n",
    "    \"        exact = [\\n\",\n",
    "    \"            n for n in candidates\\n\",\n",
    "    \"            if Path(n).name == f\\\"{patient_id}-image.nii.gz\\\"\\n\",\n",
    "    \"            or Path(n).name == f\\\"{patient_id}-label.nii.gz\\\"\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"        if len(exact) == 1:\\n\",\n",
    "    \"            return exact[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return sorted(candidates)[0]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def get_zip_member_bytes(url, entry, chunk_size=1024 * 1024):\\n\",\n",
    "    \"    # Read local file header to determine variable header length.\\n\",\n",
    "    \"    offset = entry[\\\"local_header_offset\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    header, _ = http_get_bytes(\\n\",\n",
    "    \"        url,\\n\",\n",
    "    \"        offset,\\n\",\n",
    "    \"        offset + 30 - 1,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if header[:4] != b\\\"PK\\\\x03\\\\x04\\\":\\n\",\n",
    "    \"        raise RuntimeError(\\\"Invalid local ZIP header.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    (\\n\",\n",
    "    \"        signature,\\n\",\n",
    "    \"        version,\\n\",\n",
    "    \"        flags,\\n\",\n",
    "    \"        compression,\\n\",\n",
    "    \"        mod_time,\\n\",\n",
    "    \"        mod_date,\\n\",\n",
    "    \"        crc32,\\n\",\n",
    "    \"        comp_size32,\\n\",\n",
    "    \"        uncomp_size32,\\n\",\n",
    "    \"        name_len,\\n\",\n",
    "    \"        extra_len,\\n\",\n",
    "    \"    ) = struct.unpack(\\\"<4s5H3I2H\\\", header)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    data_start = offset + 30 + name_len + extra_len\\n\",\n",
    "    \"    comp_size = entry[\\\"compressed_size\\\"]\\n\",\n",
    "    \"    data_end = data_start + comp_size - 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    chunks = []\\n\",\n",
    "    \"    for start in range(data_start, data_end + 1, chunk_size):\\n\",\n",
    "    \"        end = min(start + chunk_size - 1, data_end)\\n\",\n",
    "    \"        chunk, _ = http_get_bytes(url, start, end)\\n\",\n",
    "    \"        chunks.append(chunk)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    compressed = b\\\"\\\".join(chunks)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if compression == 0:\\n\",\n",
    "    \"        return compressed\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if compression == 8:\\n\",\n",
    "    \"        import zlib\\n\",\n",
    "    \"        return zlib.decompress(compressed, -15)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    raise RuntimeError(\\n\",\n",
    "    \"        f\\\"Unsupported ZIP compression method: {compression}\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Patient ZIP-member download helper defined.\\\")\\n\"\n",
    "   ],\n",
