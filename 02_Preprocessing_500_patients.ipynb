    "    \"        \\\"label_url\\\": \\\"https://zenodo.org/records/3893496/files/ribfrac-val-labels.zip\\\",\\n\",\n",
    "    \"        \\\"info_url\\\": \\\"https://zenodo.org/records/3893496/files/ribfrac-val-info.csv\\\",\\n\",\n",
    "    \"    },\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"TOTAL_EXPECTED = sum(v[\\\"expected_patients\\\"] for v in SOURCES.values())\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Expected labelled patients:\\\", TOTAL_EXPECTED)\\n\",\n",
    "    \"for name, cfg in SOURCES.items():\\n\",\n",
    "    \"    print(f\\\"{name}: {cfg['expected_patients']} patients\\\")\\n\"\n",
    "   ],\n",
