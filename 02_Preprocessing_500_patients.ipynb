    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Cell 3 — Final source configuration\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Official Zenodo records\\n\",\n",
    "    \"SOURCES = {\\n\",\n",
    "    \"    \\\"train_part1\\\": {\\n\",\n",
    "    \"        \\\"record\\\": \\\"3893508\\\",\\n\",\n",
    "    \"        \\\"expected_patients\\\": 300,\\n\",\n",
    "    \"        \\\"info_filename\\\": \\\"ribfrac-train-info-1.csv\\\",\\n\",\n",
    "    \"        \\\"image_zip\\\": \\\"ribfrac-train-images-1.zip\\\",\\n\",\n",
    "    \"        \\\"label_zip\\\": \\\"ribfrac-train-labels-1.zip\\\",\\n\",\n",
    "    \"        \\\"image_url\\\": \\\"https://zenodo.org/records/3893508/files/ribfrac-train-images-1.zip\\\",\\n\",\n",
    "    \"        \\\"label_url\\\": \\\"https://zenodo.org/records/3893508/files/ribfrac-train-labels-1.zip\\\",\\n\",\n",
    "    \"        \\\"info_url\\\": \\\"https://zenodo.org/records/3893508/files/ribfrac-train-info-1.csv\\\",\\n\",\n",
    "    \"    },\\n\",\n",
    "    \"    \\\"train_part2\\\": {\\n\",\n",
    "    \"        \\\"record\\\": \\\"3893498\\\",\\n\",\n",
    "    \"        \\\"expected_patients\\\": 120,\\n\",\n",
    "    \"        \\\"info_filename\\\": \\\"ribfrac-train-info-2.csv\\\",\\n\",\n",
    "    \"        \\\"image_zip\\\": \\\"ribfrac-train-images-2.zip\\\",\\n\",\n",
    "    \"        \\\"label_zip\\\": \\\"ribfrac-train-labels-2.zip\\\",\\n\",\n",
    "    \"        \\\"image_url\\\": \\\"https://zenodo.org/records/3893498/files/ribfrac-train-images-2.zip\\\",\\n\",\n",
    "    \"        \\\"label_url\\\": \\\"https://zenodo.org/records/3893498/files/ribfrac-train-labels-2.zip\\\",\\n\",\n",
    "    \"        \\\"info_url\\\": \\\"https://zenodo.org/records/3893498/files/ribfrac-train-info-2.csv\\\",\\n\",\n",
    "    \"    },\\n\",\n",
    "    \"    \\\"validation\\\": {\\n\",\n",
